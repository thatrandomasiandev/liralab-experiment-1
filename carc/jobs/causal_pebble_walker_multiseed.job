#!/bin/bash
# Multi-seed validation for postdoc Q2:
#   - ε=0.2 collapse consistency
#   - ε=0 control
# Array maps to (eps, seed) pairs.
# Submit: sbatch carc/jobs/causal_pebble_walker_multiseed.job

#SBATCH --job-name=pebble_multiseed
#SBATCH --account=biyik_1165
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=v100:1
#SBATCH --mem=32G
#SBATCH --time=48:00:00
#SBATCH --array=0-5
#SBATCH --output=/project2/biyik_1165/jjt_373/LIRALab-Experiment-1/carc/logs/multiseed-%A_%a.out
#SBATCH --error=/project2/biyik_1165/jjt_373/LIRALab-Experiment-1/carc/logs/multiseed-%A_%a.err

set -euo pipefail

ROOT="/project2/biyik_1165/jjt_373/LIRALab-Experiment-1"
mkdir -p "${ROOT}/carc/logs"
# shellcheck source=/dev/null
source "${ROOT}/carc/env.sh"
export CARC_NETID="${CARC_NETID:-$USER}"
# shellcheck source=/dev/null
source "${ROOT}/carc/env.sh"

if [[ -f /etc/profile.d/modules.sh ]]; then
  source /etc/profile.d/modules.sh
fi
module purge
module load gcc/11.3.0 2>/dev/null || module load gcc/13.3.0
module load cuda/11.8.0 2>/dev/null || module load cuda/12.4.0

# shellcheck source=/dev/null
source "${CARC_CONDA_DIR}/etc/profile.d/conda.sh"
conda activate "${CARC_ENV_NAME}"

export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl

# 3 seeds at ε=0, 3 seeds at ε=0.2 (includes original seeds for continuity)
EPS_LIST=(0 0 0 0.2 0.2 0.2)
SEED_LIST=(12345 20001 20002 12348 20011 20012)

EPS="${EPS_LIST[$SLURM_ARRAY_TASK_ID]}"
SEED="${SEED_LIST[$SLURM_ARRAY_TASK_ID]}"

cd "${ROOT}/BPref"
nvidia-smi || true

echo "Multi-seed task ${SLURM_ARRAY_TASK_ID}: teacher_eps_mistake=${EPS} seed=${SEED}"

python -u train_PEBBLE.py \
  env=walker_walk \
  seed="${SEED}" \
  device=cuda \
  agent.params.actor_lr=0.0005 \
  agent.params.critic_lr=0.0005 \
  gradient_update=1 \
  activation=tanh \
  num_unsup_steps=9000 \
  num_train_steps=500000 \
  num_interact=20000 \
  max_feedback=1000 \
  reward_batch=100 \
  reward_update=50 \
  feed_type=0 \
  teacher_beta=-1 \
  teacher_gamma=1 \
  teacher_eps_mistake="${EPS}" \
  teacher_eps_skip=0 \
  teacher_eps_equal=0 \
  enable_causal_metrics=true \
  val_fraction=0.2 \
  fixed_ref_size=256 \
  onpolicy_acc_pairs=64 \
  onpolicy_acc_episodes=3 \
  save_rm_every_update=true \
  eval_frequency=20000 \
  experiment="PEBBLE_causal_multiseed_m${EPS}"
